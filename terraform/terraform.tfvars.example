# Example Configuration for Kubernetes EC2 Terraform
aws_region                  = "us-east-1"
vpc_cidr                    = "10.0.0.0/16"
public_subnet_cidrs         = ["10.0.1.0/24", "10.0.2.0/24"]
control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.small"
worker_count                = 2

# Set to true for AWS Academy / Learner Lab (uses pre-created LabInstanceProfile)
# Set to false for standard personal accounts (creates least-privilege IAM roles)
use_aws_academy_lab_profile = true

# Optional: set EC2 key pair name if you want to SSH with a .pem key
key_name                    = ""

